# Banco (Neon). A integração da Vercel preenche DATABASE_URL e DATABASE_URL_UNPOOLED.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# URL do papel lona_app (sem BYPASSRLS), que o app usa. Gerada por `bun run db:app-role`.
DATABASE_URL_APP=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Protege /api/cron/clean (a Vercel manda como Bearer ao chamar a rotina diária).
CRON_SECRET=

# Mostra o inglês (rota /en e seletor de idioma). Desligada por padrão.
NEXT_PUBLIC_SHOW_EN=false
